{
    "version": 2,
    "builds": [
        {
            "src": "api/payme.js",
            "use": "@vercel/node"
        },
        {
            "src": "admin-panel/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/payme",
            "dest": "api/payme.js"
        },
        {
            "src": "/payme-callback",
            "dest": "api/payme.js"
        },
        {
            "src": "/(.*)",
            "dest": "admin-panel/$1"
        }
    ],
    "env": {
        "PAYME_MERCHANT_ID": "69d6d6113663bd982443630d",
        "PAYME_SECRET_KEY": "60t8uMuuzoh#K%d3XKemv#zJ0S21RouEJ0hx"
    }
}